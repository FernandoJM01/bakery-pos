PORT=3000
DATABASE_URL=postgres://pos_app:pos_app_dev_only@127.0.0.1:5432/pos_dev
MIGRATION_DATABASE_URL=postgres://pos:pos_dev_only@127.0.0.1:5432/pos_dev
JWT_SECRET=change-me-dev-only
DEVICE_TOKEN_PEPPER=change-me-dev-only
# Set to '1', 'true', or proxy hops if running behind a reverse proxy (e.g. nginx, ALB)
TRUST_PROXY=
# Comma-separated back-office origins allowed by CORS; empty = same origin only
BACKOFFICE_ORIGIN=
# Production rejects plain HTTP unless this is 'false' (LAN testing only)
REQUIRE_HTTPS=
