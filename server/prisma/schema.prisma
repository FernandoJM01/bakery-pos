generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("MIGRATION_DATABASE_URL")
}

enum Role {
  OWNER
  BRANCH_MANAGER
  CASHIER
  BAKER

  @@map("role")
}

enum DeviceType {
  TILL
  PRODUCTION

  @@map("device_type")
}

enum DeviceStatus {
  PENDING
  ACTIVE
  REVOKED

  @@map("device_status")
}

model Branch {
  id        String   @id @db.Uuid
  code      String   @unique @db.VarChar(10)
  name      String   @db.VarChar(120)
  address   String?  @db.VarChar(300)
  timezone  String   @default("America/Mexico_City") @db.VarChar(50)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  staffBranches StaffBranch[]
  devices       Device[]
  auditLogs     AuditLog[]
  sales         Sale[]
  shifts        CashShift[]
  branchPrices  BranchPrice[]
  stockLots     StockLot[]
  stockEvents   StockEvent[]
  stockWaste    StockWaste[]
  stockCounts   StockCount[]
  transfersOut  StockTransfer[] @relation("TransferFrom")
  transfersIn   StockTransfer[] @relation("TransferTo")
  orders        CustomerOrder[]

  @@map("branch")
}

model Staff {
  id                         String    @id @db.Uuid
  fullName                   String    @map("full_name") @db.VarChar(120)
  displayName                String    @map("display_name") @db.VarChar(30)
  role                       Role      @map("role")
  email                      String?   @unique @db.VarChar(255)
  passwordHash               String?   @map("password_hash") @db.VarChar(255)
  pinHash                    String    @map("pin_hash") @db.VarChar(255)
  offlinePinVerifier         String    @map("offline_pin_verifier") @db.VarChar(255)
  pinUpdatedAt               DateTime  @map("pin_updated_at") @db.Timestamptz(6)
  isActive                   Boolean   @default(true) @map("is_active")
  failedPinAttempts          Int       @default(0) @map("failed_pin_attempts")
  lockedUntil                DateTime? @map("locked_until") @db.Timestamptz(6)
  failedPasswordAttempts     Int       @default(0) @map("failed_password_attempts")
  passwordFailureWindowStart DateTime? @map("password_failure_window_start") @db.Timestamptz(6)
  passwordLockedUntil        DateTime? @map("password_locked_until") @db.Timestamptz(6)
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  staffBranches      StaffBranch[]
  createdDevices     Device[]         @relation("DeviceCreatedBy")
  createdPhotos      Photo[]          @relation("PhotoCreatedBy")
  authSessions       AuthSession[]
  actorAuditLogs     AuditLog[]       @relation("AuditLogActor")
  approverAuditLogs  AuditLog[]       @relation("AuditLogApprover")
  approverApprovals  Approval[]       @relation("ApprovalApprover")
  requesterApprovals Approval[]       @relation("ApprovalRequester")
  resolvedQuarantine SyncQuarantine[] @relation("QuarantineResolvedBy")
  sales              Sale[]           @relation("SaleCashier")
  refunds            Refund[]         @relation("RefundStaff")
  openedShifts       CashShift[]      @relation("ShiftOpenedBy")
  closedShifts       CashShift[]      @relation("ShiftClosedBy")
  cashMovements      CashMovement[]
  cashShiftNotes     CashShiftNote[]

  @@map("staff")
}

model StaffBranch {
  staffId  String @map("staff_id") @db.Uuid
  branchId String @map("branch_id") @db.Uuid

  staff  Staff  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([staffId, branchId])
  @@index([branchId])
  @@map("staff_branch")
}

model Permission {
  key         String @id @db.VarChar(100)
  description String @db.VarChar(255)

  rolePermissions RolePermission[]

  @@map("permission")
}

model RolePermission {
  role          Role   @map("role")
  permissionKey String @map("permission_key") @db.VarChar(100)

  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([role, permissionKey])
  @@map("role_permission")
}

model Device {
  id                  String       @id @db.Uuid
  branchId            String       @map("branch_id") @db.Uuid
  name                String       @db.VarChar(40)
  type                DeviceType   @map("type")
  status              DeviceStatus @default(PENDING) @map("status")
  enrollmentCodeHash  String?      @map("enrollment_code_hash") @db.VarChar(255)
  enrollmentExpiresAt DateTime?    @map("enrollment_expires_at") @db.Timestamptz(6)
  tokenHash           String?      @unique @map("token_hash") @db.VarChar(255)
  lastSeenAt          DateTime?    @map("last_seen_at") @db.Timestamptz(6)
  appVersion          String?      @map("app_version") @db.VarChar(40)
  createdBy           String?      @map("created_by") @db.Uuid
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt           DateTime?    @map("revoked_at") @db.Timestamptz(6)
  // Sales tills only (M3): numbered per branch, never reused; the folio
  // prefix is fixed at creation so queued sales keep matching it.
  tillNumber          Int?         @map("till_number")
  folioPrefix         String?      @map("folio_prefix") @db.VarChar(16)

  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  creator      Staff?        @relation("DeviceCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  authSessions AuthSession[]
  auditLogs    AuditLog[]
  approvals    Approval[]
  sales        Sale[]
  refunds      Refund[]
  shifts       CashShift[]
  syncInbox    SyncInbox[]

  @@unique([branchId, tillNumber])
  @@map("device")
}

model AuthSession {
  id                 String    @id @db.Uuid
  staffId            String    @map("staff_id") @db.Uuid
  deviceId           String?   @map("device_id") @db.Uuid
  refreshTokenHash   String    @unique @map("refresh_token_hash") @db.VarChar(255)
  rotatedTokenHashes String[]  @default([]) @map("rotated_token_hashes")
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  staff  Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([rotatedTokenHashes], type: Gin)
  @@map("auth_session")
}

model AuditLog {
  id              String   @id @db.Uuid
  occurredAt      DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  branchId        String?  @map("branch_id") @db.Uuid
  deviceId        String?  @map("device_id") @db.Uuid
  actorStaffId    String?  @map("actor_staff_id") @db.Uuid
  approverStaffId String?  @map("approver_staff_id") @db.Uuid
  action          String   @db.VarChar(100)
  entityType      String?  @map("entity_type") @db.VarChar(100)
  entityId        String?  @map("entity_id") @db.VarChar(100)
  data            Json     @default("{}") @db.JsonB

  // Restrict: deleting a referenced row must never rewrite audit history
  // (referential actions run as the table owner and bypass pos_app's grants).
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor    Staff?  @relation("AuditLogActor", fields: [actorStaffId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  approver Staff?  @relation("AuditLogApprover", fields: [approverStaffId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([occurredAt, id])
  @@index([branchId, occurredAt])
  @@map("audit_log")
}

model Approval {
  id               String    @id @db.Uuid
  tokenHash        String    @unique @map("token_hash") @db.VarChar(255)
  action           String    @db.VarChar(100)
  approverStaffId  String    @map("approver_staff_id") @db.Uuid
  requesterStaffId String    @map("requester_staff_id") @db.Uuid
  deviceId         String    @map("device_id") @db.Uuid
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt           DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  approver  Staff  @relation("ApprovalApprover", fields: [approverStaffId], references: [id], onDelete: Cascade)
  requester Staff  @relation("ApprovalRequester", fields: [requesterStaffId], references: [id], onDelete: Cascade)
  device    Device @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([approverStaffId])
  @@index([requesterStaffId])
  @@map("approval")
}

enum TaxKind {
  IVA
  IEPS

  @@map("tax_kind")
}

enum ProductUnit {
  PIECE
  KG
  PACKAGE

  @@map("product_unit")
}

model TaxRate {
  id        String   @id @db.Uuid
  kind      TaxKind  @map("kind")
  name      String   @db.VarChar(60)
  rateBp    Int      @map("rate_bp")
  isActive  Boolean  @default(true) @map("is_active")
  changeSeq BigInt   @default(0) @map("change_seq") @db.BigInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  productsAsIva  Product[] @relation("ProductIvaRate")
  productsAsIeps Product[] @relation("ProductIepsRate")

  @@index([changeSeq])
  @@map("tax_rate")
}

model Category {
  id        String   @id @db.Uuid
  name      String   @db.VarChar(60)
  sortOrder Int      @default(0) @map("sort_order")
  color     String?  @db.VarChar(7)
  isActive  Boolean  @default(true) @map("is_active")
  changeSeq BigInt   @default(0) @map("change_seq") @db.BigInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@index([changeSeq])
  @@map("category")
}

model Photo {
  id          String   @id @db.Uuid
  contentType String   @map("content_type") @db.VarChar(50)
  bytes       Int      @map("bytes")
  width       Int      @map("width")
  height      Int      @map("height")
  sha256      String   @map("sha256") @db.VarChar(64)
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator  Staff?    @relation("PhotoCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  products Product[]

  @@map("photo")
}

model Product {
  id                      String      @id @db.Uuid
  categoryId              String      @map("category_id") @db.Uuid
  name                    String      @db.VarChar(80)
  description             String?     @db.VarChar(500)
  unit                    ProductUnit @map("unit")
  photoId                 String?     @map("photo_id") @db.Uuid
  ivaRateId               String      @map("iva_rate_id") @db.Uuid
  iepsRateId              String?     @map("ieps_rate_id") @db.Uuid
  dayOldDiscountAfterDays Int?        @map("day_old_discount_after_days")
  dayOldDiscountBp        Int?        @map("day_old_discount_bp")
  dayOldWasteAfterDays    Int?        @map("day_old_waste_after_days")
  sortOrder               Int         @default(0) @map("sort_order")
  isActive                Boolean     @default(true) @map("is_active")
  changeSeq               BigInt      @default(0) @map("change_seq") @db.BigInt
  createdAt               DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  category Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  photo    Photo?           @relation(fields: [photoId], references: [id], onDelete: SetNull)
  ivaRate  TaxRate          @relation("ProductIvaRate", fields: [ivaRateId], references: [id], onDelete: Restrict)
  iepsRate TaxRate?         @relation("ProductIepsRate", fields: [iepsRateId], references: [id], onDelete: Restrict)
  variants ProductVariant[]

  @@index([categoryId])
  @@index([changeSeq])
  @@map("product")
}

model ProductVariant {
  id           String   @id @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  name         String   @db.VarChar(60)
  sku          String?  @unique @db.VarChar(40)
  barcode      String?  @unique @db.VarChar(32)
  priceCents   Int      @map("price_cents")
  costCents    Int?     @map("cost_cents")
  unitsPerTray Int?     @map("units_per_tray")
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  changeSeq    BigInt   @default(0) @map("change_seq") @db.BigInt
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchPrices  BranchPrice[]
  saleLines     SaleLine[]
  stockLots     StockLot[]
  stockEvents   StockEvent[]
  stockWaste    StockWaste[]
  orderLines    CustomerOrderLine[]
  transferLines StockTransferLine[]

  @@index([productId])
  @@index([changeSeq])
  @@map("product_variant")
}

model BranchPrice {
  variantId  String    @map("variant_id") @db.Uuid
  branchId   String    @map("branch_id") @db.Uuid
  priceCents Int       @map("price_cents")
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)
  changeSeq  BigInt    @default(0) @map("change_seq") @db.BigInt
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  branch  Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([variantId, branchId])
  @@index([branchId])
  @@index([changeSeq])
  @@map("branch_price")
}

enum SyncInboxStatus {
  APPLIED
  QUARANTINED

  @@map("sync_inbox_status")
}

/// One row per record a till ever delivered; the primary key makes delivery
/// idempotent (M2 brief 4.4).
model SyncInbox {
  recordId   String          @id @map("record_id") @db.Uuid
  deviceId   String          @map("device_id") @db.Uuid
  type       String          @db.VarChar(60)
  occurredAt DateTime        @map("occurred_at") @db.Timestamptz(6)
  receivedAt DateTime        @map("received_at") @db.Timestamptz(6)
  status     SyncInboxStatus

  device     Device          @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  quarantine SyncQuarantine?

  @@index([deviceId])
  @@map("sync_inbox")
}

/// Records the server could not apply, kept for the owner to review.
model SyncQuarantine {
  recordId       String    @id @map("record_id") @db.Uuid
  deviceId       String    @map("device_id") @db.Uuid
  branchId       String    @map("branch_id") @db.Uuid
  type           String    @db.VarChar(60)
  payload        Json
  errorCode      String    @map("error_code") @db.VarChar(40)
  errorMessage   String    @map("error_message") @db.VarChar(500)
  occurredAt     DateTime  @map("occurred_at") @db.Timestamptz(6)
  receivedAt     DateTime  @map("received_at") @db.Timestamptz(6)
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedBy     String?   @map("resolved_by") @db.Uuid
  resolutionNote String?   @map("resolution_note") @db.VarChar(500)

  inbox    SyncInbox @relation(fields: [recordId], references: [recordId], onDelete: Restrict)
  resolver Staff?    @relation("QuarantineResolvedBy", fields: [resolvedBy], references: [id], onDelete: Restrict)

  @@index([receivedAt(sort: Desc), recordId(sort: Desc)])
  @@map("sync_quarantine")
}

// ---------------------------------------------------------------- M3 sales
// Sales are written on the till and arrive as `sale.completed` sync records;
// their IDs come from the till. Money is integer centavos, tax included.

enum SaleStatus {
  COMPLETED
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
}

enum DiscountKind {
  PERCENT
  AMOUNT
}

enum PaymentMethod {
  CASH
  PREPAID
}

enum RefundKind {
  REFUND
  VOID
}

model Sale {
  id             String     @id @db.Uuid
  deviceId       String     @map("device_id") @db.Uuid
  branchId       String     @map("branch_id") @db.Uuid
  folio          String     @unique @db.VarChar(30)
  folioNumber    Int        @map("folio_number")
  cashierStaffId String     @map("cashier_staff_id") @db.Uuid
  shiftId        String?    @map("shift_id") @db.Uuid
  orderTicketId  String?    @unique @map("order_ticket_id") @db.Uuid
  occurredAt     DateTime   @map("occurred_at") @db.Timestamptz(6)
  receivedAt     DateTime   @map("received_at") @db.Timestamptz(6)
  grossCents     Int        @map("gross_cents")
  discountCents  Int        @map("discount_cents")
  totalCents     Int        @map("total_cents")
  refundedCents  Int        @default(0) @map("refunded_cents")
  status         SaleStatus @default(COMPLETED)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  device      Device           @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  branch      Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  cashier     Staff            @relation("SaleCashier", fields: [cashierStaffId], references: [id], onDelete: Restrict)
  shift       CashShift?       @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  orderTicket OrderTicket?     @relation(fields: [orderTicketId], references: [id], onDelete: Restrict)
  lines       SaleLine[]
  discounts   SaleDiscount[]
  voidedLines SaleVoidedLine[]
  payments    Payment[]
  refunds     Refund[]

  @@unique([deviceId, folioNumber])
  @@index([branchId, occurredAt])
  @@index([occurredAt])
  @@index([shiftId])
  @@map("sale")
}

model SaleLine {
  saleId             String  @map("sale_id") @db.Uuid
  lineNo             Int     @map("line_no")
  variantId          String  @map("variant_id") @db.Uuid
  productName        String  @map("product_name") @db.VarChar(120)
  variantName        String  @map("variant_name") @db.VarChar(120)
  quantity           Int
  unitPriceCents     Int     @map("unit_price_cents")
  dayOld             Boolean @default(false) @map("day_old")
  fullPriceCents     Int     @map("full_price_cents")
  grossCents         Int     @map("gross_cents")
  lineDiscountCents  Int     @map("line_discount_cents")
  orderDiscountCents Int     @map("order_discount_cents")
  netCents           Int     @map("net_cents")
  ivaRateId          String  @map("iva_rate_id") @db.Uuid
  ivaBp              Int     @map("iva_bp")
  iepsRateId         String? @map("ieps_rate_id") @db.Uuid
  iepsBp             Int     @map("ieps_bp")
  baseCents          Int     @map("base_cents")
  iepsCents          Int     @map("ieps_cents")
  ivaCents           Int     @map("iva_cents")
  refundedQuantity   Int     @default(0) @map("refunded_quantity")
  refundedCents      Int     @default(0) @map("refunded_cents")

  sale    Sale           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@id([saleId, lineNo])
  @@index([variantId])
  @@map("sale_line")
}

model SaleDiscount {
  id              String       @id @db.Uuid
  saleId          String       @map("sale_id") @db.Uuid
  lineNo          Int?         @map("line_no")
  kind            DiscountKind
  value           Int
  cents           Int
  reason          String       @db.VarChar(30)
  note            String?      @db.VarChar(120)
  approverStaffId String?      @map("approver_staff_id") @db.Uuid

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("sale_discount")
}

model SaleVoidedLine {
  saleId         String   @map("sale_id") @db.Uuid
  seq            Int
  variantId      String   @map("variant_id") @db.Uuid
  quantity       Int
  unitPriceCents Int      @map("unit_price_cents")
  voidedAt       DateTime @map("voided_at") @db.Timestamptz(6)
  staffId        String   @map("staff_id") @db.Uuid

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@id([saleId, seq])
  @@map("sale_voided_line")
}

model Payment {
  id            String        @id @db.Uuid
  saleId        String        @map("sale_id") @db.Uuid
  method        PaymentMethod
  amountCents   Int           @map("amount_cents")
  tenderedCents Int           @map("tendered_cents")
  changeCents   Int           @map("change_cents")

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("payment")
}

model Refund {
  id              String     @id @db.Uuid
  saleId          String     @map("sale_id") @db.Uuid
  kind            RefundKind
  reason          String     @db.VarChar(30)
  note            String?    @db.VarChar(120)
  deviceId        String     @map("device_id") @db.Uuid
  shiftId         String?    @map("shift_id") @db.Uuid
  staffId         String     @map("staff_id") @db.Uuid
  approverStaffId String?    @map("approver_staff_id") @db.Uuid
  occurredAt      DateTime   @map("occurred_at") @db.Timestamptz(6)
  totalCents      Int        @map("total_cents")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  sale   Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  device Device       @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  staff  Staff        @relation("RefundStaff", fields: [staffId], references: [id], onDelete: Restrict)
  shift  CashShift?   @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  lines  RefundLine[]

  @@index([saleId])
  @@index([shiftId])
  @@map("refund")
}

model RefundLine {
  refundId    String  @map("refund_id") @db.Uuid
  lineNo      Int     @map("line_no")
  quantity    Int
  amountCents Int     @map("amount_cents")
  baseCents   Int     @map("base_cents")
  iepsCents   Int     @map("ieps_cents")
  ivaCents    Int     @map("iva_cents")
  restock     Boolean

  refund Refund @relation(fields: [refundId], references: [id], onDelete: Cascade)

  @@id([refundId, lineNo])
  @@map("refund_line")
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum CashMovementKind {
  IN
  OUT
}

enum CashCountStage {
  OPEN
  CLOSE
}

/// One drawer from opening float to Z report (M4). The id comes from the till.
/// A partial unique index allows one OPEN shift per device.
model CashShift {
  id              String      @id @db.Uuid
  deviceId        String      @map("device_id") @db.Uuid
  branchId        String      @map("branch_id") @db.Uuid
  status          ShiftStatus @default(OPEN)
  zNumber         Int?        @map("z_number")
  openedAt        DateTime    @map("opened_at") @db.Timestamptz(6)
  openedByStaffId String      @map("opened_by_staff_id") @db.Uuid
  floatCents      Int         @map("float_cents")
  closedAt        DateTime?   @map("closed_at") @db.Timestamptz(6)
  closedByStaffId String?     @map("closed_by_staff_id") @db.Uuid
  expectedCents   Int?        @map("expected_cents")
  countedCents    Int?        @map("counted_cents")
  varianceCents   Int?        @map("variance_cents")
  flagged         Boolean     @default(false)
  note            String?     @db.VarChar(500)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  device    Device          @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  branch    Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  openedBy  Staff           @relation("ShiftOpenedBy", fields: [openedByStaffId], references: [id], onDelete: Restrict)
  closedBy  Staff?          @relation("ShiftClosedBy", fields: [closedByStaffId], references: [id], onDelete: Restrict)
  movements CashMovement[]
  counts    CashCount[]
  notes     CashShiftNote[]
  sales     Sale[]
  refunds   Refund[]
  prepaid   PrepaidEntry[]

  @@unique([deviceId, zNumber])
  @@index([branchId, openedAt])
  @@index([openedAt])
  @@map("cash_shift")
}

model CashMovement {
  id              String           @id @db.Uuid
  shiftId         String           @map("shift_id") @db.Uuid
  kind            CashMovementKind
  amountCents     Int              @map("amount_cents")
  reason          String           @db.VarChar(30)
  note            String?          @db.VarChar(120)
  staffId         String           @map("staff_id") @db.Uuid
  approverStaffId String?          @map("approver_staff_id") @db.Uuid
  occurredAt      DateTime         @map("occurred_at") @db.Timestamptz(6)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  shift CashShift @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  staff Staff     @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([shiftId])
  @@map("cash_movement")
}

model CashCount {
  shiftId           String         @map("shift_id") @db.Uuid
  stage             CashCountStage
  denominationCents Int            @map("denomination_cents")
  quantity          Int

  shift CashShift @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@id([shiftId, stage, denominationCents])
  @@map("cash_count")
}

model CashShiftNote {
  id        String   @id @db.Uuid
  shiftId   String   @map("shift_id") @db.Uuid
  staffId   String   @map("staff_id") @db.Uuid
  note      String   @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  shift CashShift @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  staff Staff     @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([shiftId])
  @@map("cash_shift_note")
}

enum StockEventKind {
  PRODUCTION
  SALE
  REFUND_RETURN
  WASTE
  TRANSFER_OUT
  TRANSFER_IN
  COUNT_ADJUST
}

enum TransferStatus {
  SENT
  RECEIVED
}

/// A dated batch of one variant in one branch (M5). `quantityLeft` is a stored
/// shortcut; the ledger is the truth and the nightly check compares them.
model StockLot {
  id           String   @id @db.Uuid
  branchId     String   @map("branch_id") @db.Uuid
  variantId    String   @map("variant_id") @db.Uuid
  producedOn   DateTime @map("produced_on") @db.Date
  quantityLeft Int      @map("quantity_left")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  branch  Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  events  StockEvent[]

  @@index([branchId, variantId, producedOn])
  @@map("stock_lot")
}

/// Every stock change, signed. Insert-only for pos_app (F8).
model StockEvent {
  id            String         @id @db.Uuid
  branchId      String         @map("branch_id") @db.Uuid
  variantId     String         @map("variant_id") @db.Uuid
  lotId         String?        @map("lot_id") @db.Uuid
  kind          StockEventKind
  quantity      Int
  referenceType String?        @map("reference_type") @db.VarChar(30)
  referenceId   String?        @map("reference_id") @db.Uuid
  staffId       String?        @map("staff_id") @db.Uuid
  occurredAt    DateTime       @map("occurred_at") @db.Timestamptz(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  branch  Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  lot     StockLot?      @relation(fields: [lotId], references: [id], onDelete: Restrict)

  @@index([branchId, variantId, occurredAt])
  @@index([lotId])
  @@index([referenceId])
  @@map("stock_event")
}

model StockWaste {
  id         String   @id @db.Uuid
  branchId   String   @map("branch_id") @db.Uuid
  variantId  String   @map("variant_id") @db.Uuid
  quantity   Int
  reason     String   @db.VarChar(20)
  staffId    String   @map("staff_id") @db.Uuid
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  costCents  Int?     @map("cost_cents")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  branch  Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([branchId, occurredAt])
  @@index([occurredAt])
  @@map("stock_waste")
}

model StockTransfer {
  id                String         @id @db.Uuid
  fromBranchId      String         @map("from_branch_id") @db.Uuid
  toBranchId        String         @map("to_branch_id") @db.Uuid
  status            TransferStatus @default(SENT)
  sentByStaffId     String         @map("sent_by_staff_id") @db.Uuid
  sentAt            DateTime       @map("sent_at") @db.Timestamptz(6)
  receivedByStaffId String?        @map("received_by_staff_id") @db.Uuid
  receivedAt        DateTime?      @map("received_at") @db.Timestamptz(6)
  flagged           Boolean        @default(false)

  fromBranch Branch              @relation("TransferFrom", fields: [fromBranchId], references: [id], onDelete: Restrict)
  toBranch   Branch              @relation("TransferTo", fields: [toBranchId], references: [id], onDelete: Restrict)
  lines      StockTransferLine[]

  @@index([sentAt])
  @@map("stock_transfer")
}

model StockTransferLine {
  transferId       String   @map("transfer_id") @db.Uuid
  variantId        String   @map("variant_id") @db.Uuid
  producedOn       DateTime @map("produced_on") @db.Date
  quantitySent     Int      @map("quantity_sent")
  quantityReceived Int?     @map("quantity_received")

  transfer StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Restrict)
  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@id([transferId, variantId, producedOn])
  @@map("stock_transfer_line")
}

model StockCount {
  id         String   @id @db.Uuid
  branchId   String   @map("branch_id") @db.Uuid
  staffId    String   @map("staff_id") @db.Uuid
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)

  branch Branch           @relation(fields: [branchId], references: [id], onDelete: Restrict)
  lines  StockCountLine[]

  @@map("stock_count")
}

model StockCountLine {
  countId   String @map("count_id") @db.Uuid
  variantId String @map("variant_id") @db.Uuid
  expected  Int
  counted   Int

  count StockCount @relation(fields: [countId], references: [id], onDelete: Restrict)

  @@id([countId, variantId])
  @@map("stock_count_line")
}

model StockCheck {
  id          String   @id @db.Uuid
  checkedAt   DateTime @map("checked_at") @db.Timestamptz(6)
  rowsChecked Int      @map("rows_checked")
  mismatches  Int

  @@map("stock_check")
}

enum OrderKind {
  STANDING
  ONE_OFF
}

enum OrderStatus {
  ACTIVE
  PAUSED
  ENDED
}

enum MissedRule {
  CHARGE
  NO_CHARGE
}

enum TicketStatus {
  PENDING
  PICKED_UP
  MISSED
  SKIPPED
}

enum PrepaidKind {
  PAYMENT
  PICKUP
  MISSED
  ADJUSTMENT
}

model Customer {
  id        String   @id @db.Uuid
  name      String   @db.VarChar(120)
  phone     String?  @unique @db.VarChar(20)
  rfc       String?  @db.VarChar(13)
  notes     String?  @db.VarChar(500)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  orders  CustomerOrder[]
  tickets OrderTicket[]
  prepaid PrepaidEntry[]

  @@index([name])
  @@map("customer")
}

/// A standing order repeats on weekdays; a pre-order has one date (M6).
model CustomerOrder {
  id               String      @id @db.Uuid
  customerId       String      @map("customer_id") @db.Uuid
  branchId         String      @map("branch_id") @db.Uuid
  kind             OrderKind
  /// Bit set, Monday = 1 ... Sunday = 64. Zero for a pre-order.
  weekdays         Int
  startDate        DateTime    @map("start_date") @db.Date
  endDate          DateTime?   @map("end_date") @db.Date
  pickupTime       String      @map("pickup_time") @db.VarChar(5)
  missedRule       MissedRule  @default(CHARGE) @map("missed_rule")
  status           OrderStatus @default(ACTIVE)
  pausedFrom       DateTime?   @map("paused_from") @db.Date
  pausedUntil      DateTime?   @map("paused_until") @db.Date
  note             String?     @db.VarChar(500)
  createdByStaffId String      @map("created_by_staff_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  branch   Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  lines    CustomerOrderLine[]
  skips    OrderSkip[]
  tickets  OrderTicket[]

  @@index([customerId])
  @@index([branchId, status])
  @@map("customer_order")
}

model CustomerOrderLine {
  orderId   String @map("order_id") @db.Uuid
  variantId String @map("variant_id") @db.Uuid
  quantity  Int

  order   CustomerOrder  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@id([orderId, variantId])
  @@map("customer_order_line")
}

model OrderSkip {
  orderId String   @map("order_id") @db.Uuid
  date    DateTime @db.Date

  order CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@id([orderId, date])
  @@map("order_skip")
}

/// One due day of an order, priced the day it was made.
model OrderTicket {
  id         String       @id @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  branchId   String       @map("branch_id") @db.Uuid
  customerId String       @map("customer_id") @db.Uuid
  dueDate    DateTime     @map("due_date") @db.Date
  pickupTime String       @map("pickup_time") @db.VarChar(5)
  status     TicketStatus @default(PENDING)
  totalCents Int          @map("total_cents")
  saleId     String?      @unique @map("sale_id") @db.Uuid
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  order    CustomerOrder     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines    OrderTicketLine[]
  sale     Sale?
  prepaid  PrepaidEntry[]

  @@unique([orderId, dueDate])
  @@index([branchId, dueDate])
  @@map("order_ticket")
}

model OrderTicketLine {
  ticketId       String  @map("ticket_id") @db.Uuid
  lineNo         Int     @map("line_no")
  variantId      String  @map("variant_id") @db.Uuid
  productName    String  @map("product_name") @db.VarChar(120)
  variantName    String  @map("variant_name") @db.VarChar(120)
  quantity       Int
  unitPriceCents Int     @map("unit_price_cents")
  ivaRateId      String  @map("iva_rate_id") @db.Uuid
  ivaBp          Int     @map("iva_bp")
  iepsRateId     String? @map("ieps_rate_id") @db.Uuid
  iepsBp         Int     @map("ieps_bp")

  ticket OrderTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@id([ticketId, lineNo])
  @@map("order_ticket_line")
}

/// The customer's prepaid balance is the sum of these. Insert-only (G11).
model PrepaidEntry {
  id          String      @id @db.Uuid
  customerId  String      @map("customer_id") @db.Uuid
  kind        PrepaidKind
  amountCents Int         @map("amount_cents")
  ticketId    String?     @map("ticket_id") @db.Uuid
  shiftId     String?     @map("shift_id") @db.Uuid
  deviceId    String?     @map("device_id") @db.Uuid
  staffId     String?     @map("staff_id") @db.Uuid
  occurredAt  DateTime    @map("occurred_at") @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  customer Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  ticket   OrderTicket? @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  shift    CashShift?   @relation(fields: [shiftId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([shiftId])
  @@map("prepaid_entry")
}
