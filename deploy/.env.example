# Copy to .env and fill in. Generate each secret with: openssl rand -hex 32
POSTGRES_PASSWORD=
POS_APP_PASSWORD=
JWT_SECRET=
DEVICE_TOKEN_PEPPER=

# Only needed if the back office is opened from a different address than the API.
BACKOFFICE_ORIGIN=
# Leave true. Set false only for a plain-LAN test without Tailscale.
REQUIRE_HTTPS=true
# 127.0.0.1 = only Tailscale on this computer can reach it. 0.0.0.0 = LAN test.
WEB_BIND=127.0.0.1

TZ=America/Mexico_City
# Second disk or USB drive, e.g. /media/usb/pos-backups
BACKUP_DIR=./backups
BACKUP_AT=02:30
BACKUP_KEEP_DAYS=30
